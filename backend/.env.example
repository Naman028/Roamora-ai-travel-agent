HF_TOKEN=your_huggingface_token

BASE_MODEL_ID=unsloth/Llama-3.2-3B-Instruct

# Adapter checkpoint source. Dataset repos are downloaded and loaded locally for PEFT.
ADAPTER_REPO_ID=Naman-1718/wanderly-training-backup
ADAPTER_REPO_TYPE=dataset
ADAPTER_SUBFOLDER=wanderly-3b-lora/checkpoint-1952

# Optional explicit local checkpoint path.
LOCAL_ADAPTER_PATH=

MODEL_TEMPERATURE=0.0
MODEL_MAX_INPUT_TOKENS=2000
MODEL_MAX_NEW_TOKENS=1200

# Set to "none" to skip startup preload and lazy-load on first request.
BACKEND_PRELOAD_MODEL=fine_tuned
HF_HUB_OFFLINE=1

# Backend HTTP contract and resource controls
BACKEND_ENV=development
BACKEND_API_KEY=
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_GENERATION_TIMEOUT_SECONDS=120
BACKEND_RATE_LIMIT_PER_MINUTE=20
BACKEND_MAX_CONCURRENT_GENERATIONS_PER_CLIENT=2
WANDERLY_MOCK_MODEL=false
